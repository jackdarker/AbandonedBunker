</article><article id="LogPanel"></article></section>
<script>window.gm.trialExploreEvt("Intelect")</script>


:: WM_Lv1_VineFlower_Roll [_nosave_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%=window.story.render("WM_Lv1_RollDebug")%>
<p>A purple flower emanates a strong scent.</p>
<%if(window.story.state.tmp.args[2]==1){%>
<p>Arousal +25</p><p>Intelect -5</p>
<%window.story.state.vars.qArousal+=25; 
if(s.vars.WM_Lv.qEffects["Distracted"]==0 || s.vars.WM_Lv.qEffects["Distracted"]==undefined) {
    s.vars.WM_Lv.qEffects["Distracted"]=1;
} else if(s.vars.WM_Lv.qEffects["Distracted"]>=1 && s.vars.WM_Lv.qEffects["Distracted"]<=2) {
    s.vars.WM_Lv.qEffects["Distracted"]+=1;
    window.story.state.vars.qWisdom-=5;}
%>
<p>Somehow the fumes in the air makes it hard to think. <i>Intelect reduced !</i></p>
<%}else if(s.tmp.args[2]==2 && s.tmp.args[3]=="Intelect"){%>
<p>Being careful you hold your breath and move on.</p>
<%}%>
<%window.story.state.tmp.args[2]=0;%> 
<a0 onclick='window.story.show(window.story.state.DngSY.nextLocation)'>Next</a>
</article><article id="LogPanel"></article></section>


