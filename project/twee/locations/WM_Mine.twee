:: WM_Lv1_MAP [_back_]
<hr><p>Map:</p><div id='canvas'></div></br>
<!--<script> window.gm.printMap("AM_Lv2",window.gm.player.location,window.story.state.vars.mine.mapReveal,window.story.state.vars.mine.visited);</script>-->

:: sidebar
<h3><%=window.story.name%> V<%=window.gm.getSaveVersion().toString().replaceAll(",",".")%></h3>
<img src='<%=window.gm.getSidebarPic()%>' width="256" height="256">
<div><%=window.gm.util.printLocationName(window.gm.player.location)%></br><%=window.gm.getTimeString()%></br><%=window.gm.getDateString()%></br></div><hr>
<div><%=window.gm.player.name%></br>
<%=window.gm.util.bargraph(window.story.state.vars.qSanity,window.story.state.vars.qSanityMax,"cornflowerblue","Sanity: ")%> 
<%=window.gm.util.bargraph(window.story.state.vars.qArousal,window.story.state.vars.qArousalMax,"darkorange","Arousal: ")%> 
<%="Ag:"+window.gm.util.formatNumber(window.story.state.vars.qAgility,0)+"     St:"+window.gm.util.formatNumber(window.story.state.vars.qStrength,0)+"     In:"+window.gm.util.formatNumber(window.story.state.vars.qWisdom,0)%>
<div></div>
<hr>
<form>
<button type="button" id="LinkS" onclick='window.story.show("InspectPlayer");'>Status<sup>[s]</sup></button>
<button type="button" id="LinkI" onclick='window.story.show("Inventory");'>Inventory<sup>[i]</sup></button>
<hr>
<button type="button" id="save" onclick='window.gm.toggleDialog("#dialog_save");' style="width: 80%">Save/load</button>
<!--<button type="button" id="help" onclick='window.story.show("Help_Index");' style="width: 80%">Help</button>-->
<button type="button" id="settings" onclick='window.story.show("Settings");' style="width: 80%">Settings</button>
<!--<button type="button" id="achievements" onclick='window.story.show("Achievements");' style="width: 80%">Achievements</button>-->
<%if(s._gm.debug& 0x1>0){%>
<button type="button" id="LinkD" onclick='window.story.show("debug");' style="width: 80%">Debug<sup>[d]</sup></button>
<%}%>
</form>

:: InspectPlayer [_back_ _nodeffered_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs") %>
[[Back|_back_]]</br>
TODO: what are you wearing, are you restrained, are you feeling healthy
<%if(s.vars.qLowerWear==0 && s.vars.qUpperWear==0){ %> <p>You are completely naked and feel vulnerable!</p>
<%}else if(s.vars.qLowerWear==0){%><p>Your lower half is nude.</p>
<%}else if(s.vars.qUpperWear==0){%><p>You lost your top but at least your privates are covered.</p>
<%}else{%><p>You wear some plain shirt and cargo pants</p>
<%}%>
<%if(s.vars.WM_Lv.qEffects["Distracted"]){%> <p>Distracted: You have a hard time to concentrate. (Intelect damaged)</p><%}%>
<div id='output'></div></br>[[Back|_back_]]
</article><article id="LogPanel"></article></section>

:: Inventory [_back_ _nodeffered_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs") %>
[[Back|_back_]]</br>
<%function use(slot){ return('<a href=\"javascript:void(0)\" onclick=\'window.gm.printUseItem(window.story.state.vars.Inv['+slot+'])\' ' +((window.story.state.vars.Inv[slot])?"":"hidden")+'>use '+window.story.state.vars.Inv[slot]+'</a>'+
 '<a href=\"javascript:void(0)\" onclick=\'window.gm.printRemoveItem(window.story.state.vars.Inv['+slot+']);window.gm.refreshAllPanel();\' ' +((window.story.state.vars.Inv[slot])?"":"hidden")+'>discard '+window.story.state.vars.Inv[slot]+'</a><br>');}%>
<hr><p>Inventory:</p>
<%=use(0)%><%=use(1)%><%=use(2)%><%=use(3)%>
<span <%=(window.story.state.vars.WM_Lv.qKey1!=0)?'':'hidden=""'%>>Metal Crank</span><span <%=(window.story.state.vars.WM_Lv.qFoundExit!=0)?'':'hidden=""'%>>(You found the exit but cant remember were it was exactly.)</span></br>
<span <%=false?'':'hidden=""'%>>Whetstone</span></br>
</article><article id="LogPanel"></article></section>


:: WM_Lv1_Use_Tshirt [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%if(window.story.state.vars.qUpperWear>0){%>
<p>As you already wear something, you place the item back in your pack.</p>
<%}else if(window.story.state.tmp.args[1]>0){ window.gm.printRemoveItem("Tshirt"),window.story.state.vars.qUpperWear=1;%>
<p>This is a simple Tshirt. It covers up your upper body and gives some physical protection.</p>
<%}%>
[[Back|_back_]]
</article><article id="LogPanel"></article></section>


:: WM_Lv1_Use_Shorts [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%if(window.story.state.vars.qLowerWear>0){%>
<p>As you already wear something, you place the item back in your pack.</p>
<%}else if(window.story.state.tmp.args[1]>0){ window.gm.printRemoveItem("Shorts"),window.story.state.vars.qLowerWear=1;%>
<p>Some plain shorts covering your hips and legs.</p>
<%}%>
[[Back|_back_]]
</article><article id="LogPanel"></article></section>


:: WM_Lv1_Use_HealthUp [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%if(window.story.state.vars.qSanity>=window.story.state.vars.qSanityMax){%>
<p>You feel quite healthy and should keep that for later.</p>
<%}else if(window.story.state.tmp.args[1]>0){ window.gm.printRemoveItem("HealthUp"),window.story.state.vars.qSanity+=25;%>
<p>Popping the pill into your mouth and swallowing it, after only a short time you feel already better.</p>
<%}%>
[[Back|_back_]]
</article><article id="LogPanel"></article></section>


:: WM_Lv1_Use_Adrenalin [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%if(false){%> TODO
<p>You dont have any ailment that could be helped with this drug.</p>
<%}else if(window.story.state.tmp.args[1]>0){ window.gm.printRemoveItem("Adrenalin");
if(s.vars.WM_Lv.qEffects["Distracted"]>=1) {window.story.state.vars.qWisdom+=5*s.vars.WM_Lv.qEffects["Distracted"];s.vars.WM_Lv.qEffects["Distracted"]=0;}
%>
<p>Injecting yourself with the syringe should help you removing some nasty ailments.</p>
<%}%>
[[Back|_back_]]
</article><article id="LogPanel"></article></section>

:: WM_Lv1_Use_Vibrator [_back_]
<section><aside id="sidebar"></aside><article><%=window.story.render("CenterDialogs")%>
<%if(s.vars.qArousal<=10){%>
<p>Right now you arent in the mood for some selfplay.</p>
<%}else if(window.story.state.tmp.args[1]>0){ window.gm.printRemoveItem("Vibrator"),
s.vars.qArousal=Math.max(0,s.vars.qArousal-s.vars.qArousalMax/2); %>
<p>TODO.</p>
<%}%>
[[Back|_back_]]
</article><article id="LogPanel"></article></section>


:: WM_Lv1_Encounters
<script>
function onEnter(){  //check Health damage
let state=0;
    if(window.story.state.vars.qArousal>=window.story.state.vars.qArousalMax){
        window.story.state.vars.qArousal=0;window.story.state.vars.qSanity-=25;
        window.story.show("WM_Lv1_ArousalKill");return;
    }
    if(window.story.state.vars.qSanity<=0){
        window.story.show("WM_Lv1_SanityKill");return;
    }
}
onEnter();
</script>


